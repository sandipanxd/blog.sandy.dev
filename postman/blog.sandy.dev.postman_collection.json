{
  "info": {
    "name": "blog.sandy.dev API",
    "description": "Auth, posts, comments, and likes for the blog.sandy.dev backend. Run requests top to bottom within each folder — login/signup/create requests auto-save tokens and IDs into collection variables for the requests below them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "readerToken", "value": "" },
    { "key": "reader2Token", "value": "" },
    { "key": "authorToken", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "postSlug", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (Reader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('readerToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Reader One\",\n  \"email\": \"reader1@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Signup (Reader Two — for ownership tests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('reader2Token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Reader Two\",\n  \"email\": \"reader2@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Reader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('readerToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reader1@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Author — run seed:admin first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('authorToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@blog.sandy.dev\",\n  \"password\": \"test-admin-password-123\"\n}"
            },
            "description": "Uses the local seed:admin test credentials from server/.env. Update this body to match whatever you actually seeded."
          }
        },
        {
          "name": "Google Sign-In (needs a real Google ID token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"<paste a real Google ID token here to test>\"\n}"
            },
            "description": "Can't be exercised without a real Google OAuth client — the frontend's Google Identity Services button produces the credential this endpoint expects."
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post (Author)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('postId', body.id);",
                  "if (body.slug) pm.collectionVariables.set('postSlug', body.slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authorToken}}" }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello, Blog\",\n  \"content\": \"This is my first post on the new blog.\",\n  \"excerpt\": \"First post!\",\n  \"published\": true\n}"
            }
          }
        },
        {
          "name": "List Published Posts (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "List All Posts incl. Drafts (Author)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorToken}}" }],
            "url": "{{baseUrl}}/posts/admin"
          }
        },
        {
          "name": "Get Post by Slug (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postSlug}}"
          }
        },
        {
          "name": "Get Post by Slug (as logged-in reader — shows likedByMe)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }],
            "url": "{{baseUrl}}/posts/{{postSlug}}"
          }
        },
        {
          "name": "Update Post (Author)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authorToken}}" }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello, Blog (edited)\"\n}"
            }
          }
        },
        {
          "name": "Update Post as Reader (expect 403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{readerToken}}" }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hacked\"\n}"
            }
          }
        },
        {
          "name": "Like Post (toggle on)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }],
            "url": "{{baseUrl}}/posts/{{postId}}/like"
          }
        },
        {
          "name": "Like Post again (toggle off)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }],
            "url": "{{baseUrl}}/posts/{{postId}}/like"
          }
        },
        {
          "name": "Delete Post (Author)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorToken}}" }],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment (Reader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('commentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{readerToken}}" }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great first post!\"\n}"
            }
          }
        },
        {
          "name": "List Comments for Post (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Reply to Comment (Author)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authorToken}}" }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}/reply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Thanks for reading!\"\n}"
            }
          }
        },
        {
          "name": "Reply to Comment as Reader (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{readerToken}}" }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}/reply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"I should not be allowed to do this\"\n}"
            }
          }
        },
        {
          "name": "Delete Comment as Different Reader (expect 403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{reader2Token}}" }],
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete Own Comment (Reader)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }],
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        }
      ]
    }
  ]
}
